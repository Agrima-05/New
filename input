GO

/****** Object:  StoredProcedure [dbo].[usp_load_EnhancedAbstractData]    Script Date: 8/20/2026 10:29:14 PM ******/
SET ANSI_NULLS ON
GO

SET QUOTED_IDENTIFIER ON
GO


          
CREATE         PROCEDURE [Neo_Stg_Code].[dbo].[usp_load_EnhancedAbstractData]           
(                  
 @table_schema VARCHAR(20),                  
 @is_full_data_load CHAR(1), --> 'Y' = full data load; 'N' = incremental data load                  
 @execute_enabled CHAR(1), --> 'Y' = execute SQL scripts; 'N' = do not execute SQL scripts                  
 @show_debug CHAR(1) = 'N', --> 'Y' = output debugging information, 'N' = do not output debugging information                  
 @batch_id INT = 0,                  
 @top_number INT = 0, --> 0 = full dataset; > 0 -> limit number of records for speed testing of batch process debugging                  
 @keep_working_tables CHAR(1) = 'N', --> 'N' = No, drop working tables, 'Y' = Yes, preserve working tables for debugging                  
 @csv_full_data_load_only CHAR(1) = 'N', --> 'N' = No, both tables, 'Y' = Yes, only reload the CSV tables                  
 @cmtTriggerID int,              
 @out_error_message VARCHAR(1000) OUTPUT                  
)                  
AS                  
/*                  
 PARAMETERS:                  
                  
 --> Optional id for batch processing to group all processed                  
  counties together for log filtering                  
 @batch_id  : default is 0, set to any int value                   
                  
 --> used to enable or disable data load                  
 @execute_enabled : Y - to load data                  
      : N - do not execute                  
                  
 --> used to show dynamic script                  
 @show_debug  : Y - print out dynamic SQL code                  
     : N - do not print                  
                  
 --> only select / insert top number of records.  Use for testing                  
  batch process                  
 @top_number  : 0 - not used                  
     : >0 - will add a top number: SELECT TOP(@top_number)                  
                  
 --> used to control if full data load or incremental                  
 @is_full_data_load  : 'Y' - drop and reload ALL data                  
      : 'N'- incremental data based on ETL record changes                  
                  
 @keep_working_tables : 'Y' = Yes, preserve working tables for debugging                   
       : 'N' = No, drop tables created to perform the work tables                  
                  
 @csv_full_data_load_only : 'Y' = Yes, only reload the LAND_DOC_NAME_REF_CSV table                  
        : 'N' = No, both LAND_DOC_NAME_REF & LAND_DOC_NAME_REF_CSV                  
                  
 ******  Testing EXAMPLE *******                  
                    
 DECLARE @out_error_message   varchar(1000)                    
 DECLARE @execute_enabled   char(1)   = 'N'                    
 DECLARE @show_debug     char(1)   = 'Y'                    
 DECLARE @is_full_data_load   char(1)   = 'Y'                    
 DECLARE @keep_working_tables  char(1)   = 'N'                    
 DECLARE @csv_full_data_load_only char(1)   = 'N'                     
                    
 EXECUTE dbo.usp_load_EnhancedAbstractData_sharat                    
      @batch_id     = 0 --> testing                    
     ,@table_schema    = 'txbp'                    
     ,@execute_enabled   = @execute_enabled                    
     ,@show_debug    = @show_debug                    
     ,@top_number    = 0                    
     ,@is_full_data_load   = @is_full_data_load                    
     ,@keep_working_tables  = @keep_working_tables                    
     ,@csv_full_data_load_only = @csv_full_data_load_only                    
     ,@out_error_message   = @out_error_message                    
  ,@cmtTriggerID =-1        
        
  Select @out_error_message        
--*/           
        
        
BEGIN                  
SET NOCOUNT ON;                  
                  
DECLARE @sql    varchar(max) = '' --> used to fake SQL for strings exceeding unicode 4000 length.                  
DECLARE @nsql    nvarchar(max) = N'' --> caution!!! this is actually only 4000 chars long when using SET @nsql = N'...'; must use SET @nsql = @sql                   
DECLARE @qualified_name  varchar(80)  = 'Neo.'                   
                  
DECLARE @process_id   int                   
DECLARE @row_count   int    = 0                  
DECLARE @final_row_count int    = 0                  
DECLARE @final_row_count_combined int    = 0                  
DECLARE @datetime   datetime                   
                  
DECLARE @ntile_value  int    = 1 --> default to 1 to prevent execution error                  
DECLARE @csv_batch_size  int                    
DECLARE @csv_batch_number int    = 1   --> batch starts at 1                  
DECLARE @csv_total_batches int                   
DECLARE @document_count  int            
DECLARE @document_count2 INT                  
                  
DECLARE @msg    varchar(500) = ''                  
DECLARE @log_info   varchar(8000) = ''                  
DECLARE @id_range  varchar(30)                  
DECLARE @max_date   datetime                    
                
Declare @DL_land_count int                
                  
                  
                  
BEGIN TRY                  
                  
 /*                  
  Check for existance of schema and if county is active                   
  in order to continue.                  
 */                  
                  
 --> check for existance of schema.              
             
 if ISNULL(@cmtTriggerID,0)=0            
 BEGIN            
 RAISERROR ('Invalid TriggerId',16,1);            
 RETURN            
 END            
            
            
 IF NOT EXISTS ( SELECT  1                  
      FROM    NEO.information_schema.schemata                  
      WHERE   schema_name = @table_schema                  
     )                  
 BEGIN                  
  RAISERROR ('Invalid Schema name!',16,1);                  
 END                  
 ELSE                  
 BEGIN                  
  --> check for active county                   
  IF NOT EXISTS ( SELECT 1                           
       FROM NEO.dbo.LAND_DOC_NAME_REF_controller WITH (NOLOCK)                     
       WHERE is_active_incremental    = 1                  
       AND  table_schema      = @table_schema                  
      )                  
  BEGIN                  
   SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' County '                   
     + @table_schema + ' not active!';                  
   --> return without logging                   
   RAISERROR (@msg, 0, 1) WITH NOWAIT                  
   RETURN 0 --> end, county is not active                  
  END                  
  ;                  
  --> prepend Database                  
  SET @qualified_name = @qualified_name + @table_schema;                  
 END                  
 ;                  
                
 Select @csv_batch_size=ISNULL(csv_batch_size,0) from NEO.dbo.LAND_DOC_NAME_REF_controller where table_schema=@table_schema                
 if @csv_batch_size is null or @csv_batch_size<=0                
  set @csv_batch_size=50000--set to default batch size                
                
 IF @execute_enabled = 'Y'                   
 BEGIN                    
  /*                   
   log start of process                  
  */                  
  SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' Start '                   
     + @table_schema + case when @csv_full_data_load_only = 'Y' then ' CSV only'                  
           when @is_full_data_load = 'Y' then ' full'                   
          else ' incremental'                   
         end + ' data load!';                  
                    
  RAISERROR (@msg, 0, 1) WITH NOWAIT                  
                    
  SET @log_info = @msg                  
                  
  --> create process id                  
  EXECUTE @process_id =  dbo.usp_land_doc_name_ref_log_insert_v2                   
           @batch_id    = @batch_id                  
          ,@table_schema   = @table_schema          
    ,@cmtTriggerID=@cmtTriggerID              
          ,@out_error_message  = @out_error_message              
                  
  ;                  
                   
  /*                   
   check for existance of table(s) for process; throw error and exit if not found                   
  */                  
  IF NOT EXISTS      
  ( SELECT 1                  
   FROM NEO.INFORMATION_SCHEMA.TABLES                   
   WHERE TABLE_SCHEMA = @table_schema                  
   AND  TABLE_NAME = 'FCT_land_document'  --> base table for denormalize of data                  
  )                  
  BEGIN                  
    SET @msg = 'Neo.' + @table_schema + '.FCT_land_document does not exist!';          
                    
    RAISERROR (@msg, 16, 1);                   
  END                  
  ;                  
                   
 END                  
 ;                  
                  
 /*********** BUILD TEMP TABLE FOR INCREMENTAL DATA LOADS **********/                  
                  
 IF @is_full_data_load = 'N' --> NOT a full data load                  
 BEGIN                   
  /*                   
   check for existance of table to process; throw error and exit if not found                   
  */                  
  IF NOT EXISTS                   
  ( SELECT 1                  
   FROM NEO.INFORMATION_SCHEMA.TABLES                   
   WHERE TABLE_SCHEMA = @table_schema                  
   AND  TABLE_NAME = 'Incremental_Documents'                    
  )                  
  BEGIN                  
    SET @msg = 'Neo.' + @table_schema + '.Incremental_Documents does not exist!';                  
                    
    RAISERROR (@msg, 16, 1);                   
  END                  
  ;                   
                  
  --> drop table                   
  SET @nsql = N'DROP TABLE IF EXISTS ' + @qualified_name + '.__Incremental_Documents;'                  
  ;                  
  IF @show_debug = 'Y' PRINT @nsql;                  
                   
  IF @execute_enabled = 'Y' EXECUTE sp_executesql @nsql;                  
                   
  --> read in change set to working table                  
  SET @nsql = N'SELECT INCR_row_id' + char(10)                  
     + '   ,INCR_DEF_document_nbr' + char(10)                  
     + '   ,INCR_DEF_document_seq' + char(10)                  
     + '' + char(10)                  
     + 'INTO ' + @qualified_name + '.__Incremental_Documents' + char(10)                  
     + '' + char(10)                  
     + 'FROM ' + @qualified_name + '.Incremental_Documents WITH (NOLOCK)' + char(10)                  
     + '' + char(10)                  
     + 'WHERE INCR_row_processed_flag  = ''N''' + char(10)                  
                  
  IF @show_debug = 'Y' PRINT @nsql;                  
                   
  IF @execute_enabled = 'Y'                   
  BEGIN                  
   EXECUTE sp_executesql @nsql;                  
                     
   SET @row_count = @@ROWCOUNT                  
                 
                  
   SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' __Incremental_Documents rows inserted: ' + cast(@row_count as varchar(15));                  
                    
   RAISERROR (@msg, 0, 1) WITH NOWAIT;                  
                  
   SET @log_info = @log_info + char(10) + @msg;                      
  END                  
  ;                  
                    
  --> Found records to process                  
  IF @row_count > 0 OR /* output SQL script when not processing */                  
  (@execute_enabled = 'N' AND  @show_debug = 'Y')                   
  BEGIN                  
   --> read in change set to working table                  
   SET @nsql = N'SELECT @id_range = ''['' + cast(min(INCR_row_id) as varchar(15)) + ''-'' + cast(max(INCR_row_id) as varchar(15)) + '']''' + char(10)                  
      + 'FROM ' + @qualified_name + '.__Incremental_Documents' + char(10)                  
                  
   IF @show_debug = 'Y' PRINT @nsql;                  
                   
   IF @execute_enabled = 'Y'                   
   BEGIN                  
    EXECUTE sp_executesql @nsql, N'@id_range varchar(30) OUTPUT',@id_range = @id_range OUTPUT;                  
                     
    --select id_range = 'Range: ' +@id_range                  
                  
    SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' Row id range = ' + isnull(@id_range, '<NULL>');                  
                    
    RAISERROR (@msg, 0, 1) WITH NOWAIT;       
                  
    SET @log_info = @log_info + char(10) + @msg;                      
                  
   END                  
   ;                  
                  
   --> load __update_doc_id_filter                   
   SET @nsql = N'DROP TABLE IF EXISTS ' + @qualified_name + '.__update_doc_id_filter;' + char(10)                  
   ;                  
   IF @show_debug = 'Y' PRINT @nsql;                  
                   
   IF @execute_enabled = 'Y' EXECUTE sp_executesql @nsql;                  
                  
   /*********************  BUILD Script to insert changed records from ETL *******/                  
   --> get doc ids that are 'AT' union doc ids from LAND_DOC_NAME_REF that were deleted in ETL                  
   SET @nsql = N'SELECT  DD_DOCUMENT_ID' + char(10)                  
      + '' + char(10)                  
      + 'INTO ' + @qualified_name + '.__update_doc_id_filter' + char(10)                  
      + '' + char(10)                      
      + 'FROM' + char(10)                  
      + '(' + char(10)                  
      + ' SELECT  DD_DOCUMENT_ID' + char(10)                  
      + '' + char(10)                  
      + ' FROM  ' + @qualified_name + '.DIM_document    dd  WITH(NOLOCK)' + char(10)                   
      + '' + char(10)                  
      + ' INNER JOIN ' + @qualified_name + '.FCT_LAND_DOCUMENT   fld  WITH(NOLOCK)' + char(10)                  
      + ' ON   fld.FLD_DD_DOC_ID     =  dd.DD_DOCUMENT_ID' + char(10)                  
      + '' + char(10)                  
      + ' INNER JOIN ' + @qualified_name + '.DIM_LAND     dl  WITH (NOLOCK)' + char(10)                  
      + ' ON   dl.DL_land_id      =  fld.FLD_dl_land_id' + char(10)                  
      + '' + char(10)                  
      + ' INNER JOIN ' + @qualified_name + '.__Incremental_Documents  i  WITH (NOLOCK)' + char(10)                  
      + ' ON  i.INCR_DEF_document_nbr    =  dd.DD_document_number' + char(10)                  
      + ' AND   i.INCR_DEF_document_seq    =  dd.DD_document_seq' + char(10)                  
      + '' + char(10)                  
      + ' WHERE  dl.DL_land_type      =  ''AT''' + char(10)                  
      + '' + char(10)                  
      + ' UNION' + char(10)                  
      + '' + char(10)                  
      + ' SELECT  r.DD_DOCUMENT_ID' + char(10)                  
      + '' + char(10)                  
      + ' FROM  ' + @qualified_name + '.LAND_DOC_NAME_REF   r  ' + char(10)                  
      + '' + char(10)                  
      + ' INNER JOIN ' + @qualified_name + '.__Incremental_Documents  i  WITH (NOLOCK)' + char(10)                  
      + ' ON   i.INCR_DEF_document_nbr    =  r.DD_document_number' + char(10)                  
      + ' AND   i.INCR_DEF_document_seq     =  r.DD_document_seq' + char(10)                  
      + ')a' + char(10)                  
      + ';' + char(10)                  
   ;                  
                  
   IF @show_debug = 'Y' PRINT @nsql;                  
                   
   IF @execute_enabled = 'Y'                   
   BEGIN                  
                      
    EXECUTE sp_executesql @nsql;                  
                  
    SET @row_count = @@ROWCOUNT;                  
                  
    SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' __update_doc_id_filter rows inserted: ' + cast(@row_count as varchar(15));                  
                    
    RAISERROR (@msg, 0, 1) WITH NOWAIT;                  
                  
    SET @log_info = @log_info + char(10) + @msg;                      
   END                  
   ;                  
                  
   --> no AT records                  
   IF @row_count = 0 OR /* output SQL script when not processing */                  
   (@execute_enabled = 'N' AND  @show_debug = 'Y')                   
   BEGIN                  
                  
    --> update ETL table                  
    SET @nsql = N'UPDATE  i ' + char(10)                  
       + '' + char(10)                  
       + 'SET  INCR_row_processed_flag    = ''Y''' + char(10)                  
       + '' + char(10)      
       + 'FROM  '+ @qualified_name + '.Incremental_Documents   i ' + char(10)                  
       + '' + char(10)                  
       + 'INNER JOIN '+ @qualified_name + '.__Incremental_Documents w ' + char(10)                  
       + 'ON   i.INCR_row_id      = w.INCR_row_id'                  
       + ';'  + char(10)                   
 ;                  
                  
    IF @show_debug = 'Y' PRINT @nsql;                  
                   
    IF @execute_enabled = 'Y'                   
    BEGIN                  
     EXECUTE sp_executesql @nsql;                  
                     
     SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' Incremental_Documents rows updated: ' + cast(@@ROWCOUNT as varchar(15));                  
                    
     RAISERROR (@msg, 0, 1) WITH NOWAIT;                  
                  
     SET @log_info = @log_info + char(10) + @msg;                      
                  
    END                  
    ;                  
                  
                         
    /* table cleanup */                  
    IF @keep_working_tables = 'N'                  
    BEGIN                  
     --> drop table                   
     SET @nsql = N'DROP TABLE IF EXISTS ' + @qualified_name + '.__update_doc_id_filter;' + char(10)                  
     ;                  
     IF @show_debug = 'Y' PRINT @nsql;                  
                   
     IF @execute_enabled = 'Y' EXECUTE sp_executesql @nsql;                  
                      
     SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' __update_doc_id_filter dropped...';                  
                    
     RAISERROR (@msg, 0, 1) WITH NOWAIT;                   
                  
     SET @log_info = @log_info + char(10) + @msg;                      
                       
     --> drop table                   
     SET @nsql = N'DROP TABLE IF EXISTS ' + @qualified_name + '.__Incremental_Documents';                  
     ;                  
     IF @show_debug = 'Y' PRINT @nsql;                  
                   
     IF @execute_enabled = 'Y' EXECUTE sp_executesql @nsql;                  
                      
     SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' __Incremental_Documents dropped...';                  
                    
     RAISERROR (@msg, 0, 1) WITH NOWAIT;                   
                  
     SET @log_info = @log_info + char(10) + @msg;                    
    END                  
    ;                  
                  
    -----------------------------------------------------------------------                  
    SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' No ''AT'' records. Process...complete!';                  
                    
    RAISERROR (@msg, 0, 1) WITH NOWAIT;                   
                  
    SET @log_info = @log_info + char(10) + @msg;                      
                  
                  
    IF @execute_enabled = 'Y'                   
    BEGIN                  
     --> log finish time and num records to land, doc, name ref table                  
     SET @datetime = getdate()                  
                       
     --> update logging                  
     EXECUTE [Neo_Stg_Code].dbo.usp_land_doc_name_ref_log_update                  
           @land_doc_name_ref_log_id  = @process_id                  
           ,@end_time      = @datetime            
           ,@number_records    = @row_count                  
           ,@log_info      = @log_info                  
           ,@out_error_message    = @out_error_message                  
     ;                   
    END                  
    ;                  
    RETURN 0                  
    ;                  
                  
   END                  
   ;                  
                  
   --> build indexes                   
   SET @nsql = N'CREATE CLUSTERED INDEX ci_update_doc_id_filter__dd_document_id' + char(10)                  
      + 'ON ' + @qualified_name + '.__update_doc_id_filter  (DD_DOCUMENT_ID)'+ char(10)                  
      + ';'+ char(10)                  
   ;                  
   IF @show_debug = 'Y' PRINT @nsql;                  
                   
   IF @execute_enabled = 'Y'             
   BEGIN                  
                  
    EXECUTE sp_executesql  @nsql;                  
                     
    SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' Found ''AT'' records, inserted:' + CAST(@row_count as varchar(15)) + ' into __update_doc_id_filter';                  
                     
    RAISERROR (@msg, 0, 1) WITH NOWAIT;                  
                    
    SET @log_info = @log_info + char(10) + @msg;                  
                  
   END                  
   ;                  
  END--> Found records to process                  
  ELSE                
  BEGIN                  
   --> drop table                   
   SET @nsql = N'DROP TABLE IF EXISTS ' + @qualified_name + '.__Incremental_Documents';                  
   ;                  
   IF @show_debug = 'Y' PRINT @nsql;                  
                   
   IF @execute_enabled = 'Y' EXECUTE sp_executesql @nsql;                  
                 
   SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' __Incremental_Documents dropped...';                  
                    
   RAISERROR (@msg, 0, 1) WITH NOWAIT;                   
                  
   SET @log_info = @log_info + char(10) + @msg;                    
                  
   ----------------------------------------------                   
   SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + ' No new incremental document records. Process...complete!';                  
                    
   RAISERROR (@msg, 0, 1) WITH NOWAIT;                   
                  
   SET @log_info = @log_info + char(10) + @msg;                      
                  
                  
                  
   IF @execute_enabled = 'Y'                   
   BEGIN                  
    --> log finish time and num records to land, doc, name ref table                  
    SET @datetime = getdate()                  
                      
    --> update logging                  
    EXECUTE [Neo_Stg_Code].dbo.usp_land_doc_name_ref_log_update                  
           @land_doc_name_ref_log_id  = @process_id                  
          ,@end_time      = @datetime                  
          ,@number_records    = @row_count                  
          ,@log_info      = @log_info                  
          ,@out_error_message    = @out_error_message                 
    ;                   
   END                  
   ;                  
                  
   RETURN 0                  
   ;                  
                  
  END                  
  ;                   
 END                  
 ELSE                    
 /* Full data load */                  
 BEGIN                  
                    
  /*                  
   If only updating CSV, then do not update incremental documents                  
  */                  
  IF  @csv_full_data_load_only = 'N'                  
  BEGIN                  
   /*                   
     check for existance of table to process - get max date if exists                   
                  
     The purpose of getting max date is to prevent records that may be                   
     added from ETL process during load of data being updated as processed                  
     at end of denormalized table data load.  If records are added, this                   
     process will only update the existing records up to the max date and                  
     leave any additional added records as "not processed" - these records                  
     will get processed on the next incremental update run.                  
                      
   */                  
   IF EXISTS                   
   ( SELECT 1                  
    FROM NEO.INFORMATION_SCHEMA.TABLES                   
    WHERE TABLE_SCHEMA = @table_schema                  
    AND  TABLE_NAME = 'Incremental_Documents'                    
   )                  
   BEGIN                  
    SET @nsql = N'SELECT @max_date = max(INCR_update_date)' + char(10)                  
       + '' + char(10)                  
       + 'FROM ' + @qualified_name + '.Incremental_Documents WITH (NOLOCK)' + char(10)                  
       + '' + char(10)                  
       + 'WHERE INCR_row_processed_flag  = ''N''' + char(10)                                  
    IF @show_debug = 'Y' PRINT @nsql;                    
    ;                   
                  
    IF @execute_enabled = 'Y'                   
    BEGIN                   
     --> passes ntile value out to varialbe                  
     EXECUTE sp_executesql  @nsql, N'@max_date datetime OUTPUT',@max_date   output                  
     ;                  
                  
     SET @msg = CONVERT(VARCHAR(8), GETDATE(), 108) + '  @max_date: ' + isnull(CAST(@max_date as varchar(25)),'<no records to process>');                  
                  
                     
     RAISERROR (@msg, 0, 1) WITH NOWAIT;                  
                  
     SET @log_info = @log_info + char(10) + @msg;                     
    END                  
    ;                  
   END                  
   ;                  
  END                  
  ;                  
 END                  
 ;                  
                  
 /*                  
  When reloading CSV, skip all other table processing.  Use                  
  existing Land_Doc_Name_Ref to get document ids.                  
 */                  
 IF @csv_full_data_load_only = 'N'                  
 BEGIN                  
                  
                  
  /**************** BUILD FND_PIVOT TABLE  ***************************                  
                  
   Drop pivot table because it's only used in this process                  
   and will not affect other processes.                  
                  
   Used to create the list of Party 1 [R] and Party 2 [E]  and PartyOthers [O]               
   along with the Party_seq and joined with Land_Doc_Name_Ref                   
   table.                  
                  
  ********************************************************************/                  
  --> drop table                   
  SET @nsql = N'DROP TABLE IF EXISTS ' + @qualified_name + '.FND_PIVOTED;' + char(10)                  
  ;                  
  IF @show_debug = 'Y' PRINT @nsql;                  
                   
  IF @execute_enabled = 'Y' EXECUTE sp_executesql @nsql;                  
                  
  --> insert data                  
  SET @sql = N'SELECT ' + case when @top_number > 0 then 'TOP('+ cast(@top_number as varchar(10))+')' else '' end + char(10)                  
     + '  FND_dd_doc_id' + char(10)                  
     + '  ,Party_Seq' + char(10)                 + '  ,R' + char(10)                  
     + '  ,E' + char(10)         
  + '  ,O' + char(10)        
     + '' + char(10)                  
     + 'INTO ' + @qualified_name + '.FND_PIVOTED' + char(10)                  
     + '' + char(10)                  
     + 'FROM' + char(10)                  
     + '(' + char(10)                  
     + ' SELECT FND_dd_doc_id' + char(10)                  
     + '   ,Party_Seq' + char(10)                  
     + '   ,FND_name_role_type' + char(10)                  
     + '   ,FND_dn_name_id' + char(10)                  
     + ' FROM' + char(10)         
     + ' (' + char(10)                  
     + '  SELECT e.FND_dd_doc_id' + char(10)                  
     + '    ,e.FND_name_role_type' + char(10)                  
     + '    ,e.FND_dn_name_id' + char(10)                  
     + '    ,Party_Seq      = row_number() over(partition by e.FND_dd_doc_id order by e.FND_dn_name_id)' + char(10)                  
     + '  FROM' + char(10)                  
     + '  (' + char(10)                  
     + '   SELECT  DISTINCT ' + char(10)                  
     + '       fnd.FND_dn_name_id' + char(10)                  
     + '      ,fnd.FND_dd_doc_id' + char(10)                  
     + '      ,fnd.FND_name_role_type ' + char(10)                  
     + '' + char(10)                     
     + '   FROM  ' + @qualified_name + '.FCT_NAME_DOCUMENT fnd WITH (NOLOCK)' + char(10)                  
     + '' + char(10)                 
     + '   INNER JOIN ' + @qualified_name + '.FCT_LAND_DOCUMENT fld WITH (NOLOCK)' + char(10)                  
     + '   ON   fld.FLD_DD_DOC_ID   = fnd.FND_dd_doc_id' + char(10)                  
     + '' + char(10)                  
     + '   INNER JOIN ' + @qualified_name + '.DIM_LAND   DL WITH (NOLOCK)' + char(10)                  
     + '   ON   DL.DL_land_id    = fld.FLD_dl_land_id' + char(10)                   
     + '' + char(10)                   
                      
  IF @is_full_data_load = 'N' --> NOT a full data load                  
  BEGIN                   
   --> add in filter                     
   SET @sql = @sql                  
     + '   INNER JOIN ' + @qualified_name + '.__update_doc_id_filter   d' + char(10)                  
     + '   ON   d.DD_DOCUMENT_ID   = fnd.FND_dd_doc_id' + char(10)                  
     + '' + char(10)                  
  END                  
  ;                  
                  
